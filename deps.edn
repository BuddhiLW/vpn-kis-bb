{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  org.babashka/cli    {:mvn/version "0.8.67"}
  babashka/fs         {:mvn/version "0.5.32"}
  cheshire/cheshire   {:mvn/version "6.2.0"}
  com.taoensso/timbre {:mvn/version "6.8.0"}

  io.github.hive-agi/hive-dsl    {:git/tag "v0.5.1" :git/sha "335869e"}
  io.github.hive-agi/hive-system {:git/tag "v0.2.4" :git/sha "0706c57"}
  io.github.hive-agi/hive-weave  {:git/tag "v0.2.5" :git/sha "5895a2a"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/test.check {:mvn/version "1.1.1"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:dirs ["test"]}}

  :nrepl
  {:extra-paths ["test" "dev"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}
                cider/cider-nrepl {:mvn/version "0.45.0"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"
               "--port" "7822"]}}}
