#!/bin/sh
# Build and smoke-test the native vpn-kis binary with ClojureWasm.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f "$0")")/.." && pwd)
mkdir -p "$root/build"
candidate=$(mktemp "$root/build/vpn-kis.XXXXXX")
output=$(mktemp "${TMPDIR:-/tmp}/vpn-kis-build-check.XXXXXX")
trap 'rm -f "$candidate" "$output"' EXIT

# From /: cljw reads a deps.edn in the working directory, and the Maven/git
# deps there are the Babashka ones, not the cljw/ compat layer.
cd /
cljw build -m vpn-kis-bb.cli.main \
    -cp "$root/cljw:$root/src" \
    -o "$candidate"
chmod +x "$candidate"

if ! VPN_KIS_BIN="$candidate" "$root/bin/dry-run-check" >"$output" 2>&1; then
    echo "native build failed dry-run checks:" >&2
    rg '^FAIL ' "$output" >&2 || tail -10 "$output" >&2
    exit 1
fi

mv -f "$candidate" "$root/build/vpn-kis"

echo "built $root/build/vpn-kis"
